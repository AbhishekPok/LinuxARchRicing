#!/usr/bin/env python3
"""Build a Google Chrome theme from theme-manager's palette.

Chrome has no userChrome.css: its own UI cannot be styled with CSS at all.
What carries over from adrsha/nix-dots' Firefox userChrome/userContent is the
colour layer, so this maps the same --tm-* tokens onto Chrome's theme keys,
region for region:

  Firefox (nix-dots)                      Chrome theme key
  #navigator-toolbox / #TabsToolbar  bg   frame
  .tab-background[selected]          deep toolbar (= active tab)
  #urlbar[focused] background        deep omnibox_background
  about:newtab / about:home          deep ntp_background
  tab / page text                    fg   tab_text, bookmark_text, ntp_text
  inactive tabs, icons               dim  tab_background_text, toolbar_button_icon
  accent                             accent ntp_link

Output: ~/.config/theme-manager/chrome-theme/ (an unpacked theme extension).
Load it once from chrome://extensions > Developer mode > Load unpacked.
Chrome re-reads unpacked extensions on start, so later theme switches only
need a Chrome restart (or the extension's reload button).
"""
import json
import re
import sys
from pathlib import Path

HOME = Path.home()
SOURCE = HOME / ".config/theme-manager/firefox-colors.css"
OUT = HOME / ".config/theme-manager/chrome-theme"

# nix-dots' fallbacks, used for any token the generated file lacks
FALLBACK = {
    "deep": "#131319", "bg": "#20202a", "surface": "#3b3b4d", "raised": "#44495e",
    "hover": "#51566a", "border": "#44495e", "fg": "#e8eaee", "dim": "#c6d0e9",
    "accent": "#cddbf9", "on-accent": "#20202a",
}


def palette() -> dict:
    tokens = dict(FALLBACK)
    try:
        text = SOURCE.read_text()
    except OSError:
        print(f"chrome-theme-sync: {SOURCE} missing, using nix-dots fallbacks", file=sys.stderr)
        return tokens
    for name, value in re.findall(r"--tm-([\w-]+):\s*(#[0-9a-fA-F]{6})", text):
        tokens[name] = value
    return tokens


def rgb(hex_colour: str) -> list:
    h = hex_colour.lstrip("#")
    return [int(h[i:i + 2], 16) for i in (0, 2, 4)]


def main() -> None:
    c = {k: rgb(v) for k, v in palette().items()}
    colors = {
        "frame": c["bg"],
        "frame_inactive": c["bg"],
        "frame_incognito": c["bg"],
        "frame_incognito_inactive": c["bg"],
        "background_tab": c["bg"],
        "background_tab_inactive": c["bg"],
        "toolbar": c["deep"],
        "toolbar_text": c["fg"],
        "toolbar_button_icon": c["dim"],
        "tab_text": c["fg"],
        "tab_background_text": c["dim"],
        "tab_background_text_inactive": c["dim"],
        "bookmark_text": c["fg"],
        "omnibox_background": c["deep"],
        "omnibox_text": c["fg"],
        "ntp_background": c["deep"],
        "ntp_header": c["raised"],
        "ntp_text": c["fg"],
        "ntp_link": c["accent"],
        "button_background": c["deep"] + [0],
    }
    manifest = {
        "manifest_version": 3,
        "name": "theme-manager (nix-dots)",
        "version": "1.0",
        "description": "Generated by chrome-theme-sync from theme-manager's palette.",
        "theme": {
            "colors": colors,
            "tints": {"buttons": [-1, -1, -1]},
            "properties": {"ntp_background_alignment": "bottom"},
        },
    }
    OUT.mkdir(parents=True, exist_ok=True)
    (OUT / "manifest.json").write_text(json.dumps(manifest, indent=2) + "\n")
    print(f"chrome-theme-sync: wrote {OUT / 'manifest.json'}")


if __name__ == "__main__":
    main()
