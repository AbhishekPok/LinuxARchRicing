{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "file",
    "source": "/home/abhi/.config/fastfetch/logo/devops.txt",
    "padding": {
      "top": 1,
      "left": 2,
      "right": 5
    }
  },

  "display": {
    "separator": "  ",
    "color": {
      "keys": "green",
      "title": "cyan"
    },
    "key": {
      "width": 13
    }
  },

  "modules": [
    {
      "type": "title",
      "format": "󰣇  RUBY // ARCH OPS"
    },
    {
      "type": "custom",
      "format": "━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    },
    {
      "type": "os",
      "key": "󰣇 OS"
    },
    {
      "type": "kernel",
      "key": "󰒋 Kernel"
    },
    {
      "type": "wm",
      "key": " WM"
    },
    {
      "type": "terminal",
      "key": " Terminal"
    },
    {
      "type": "shell",
      "key": " Shell"
    },
    {
      "type": "packages",
      "key": "󰏖 Packages"
    },
    {
      "type": "custom",
      "format": "────────────────────────────"
    },
    {
      "type": "cpu",
      "key": "󰍛 CPU"
    },
    {
      "type": "gpu",
      "key": "󰢮 GPU"
    },
    {
      "type": "memory",
      "key": "󰑭 Memory"
    },
    {
      "type": "swap",
      "key": "󰓡 Swap"
    },
    {
      "type": "custom",
      "format": "────────────────────────────"
    },
    {
      "type": "disk",
      "key": "󰋊 Root",
      "folders": "/"
    },
    {
      "type": "disk",
      "key": "󰋊 HDD",
      "folders": "/home/abhi/HDD"
    },
    {
      "type": "localip",
      "key": "󰩠 IP"
    },
    {
      "type": "battery",
      "key": "󰁹 Battery"
    },
    {
      "type": "custom",
      "format": "━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    },
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
