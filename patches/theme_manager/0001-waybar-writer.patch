@@ -0,0 +1,223 @@
+use crate::{rgb_str, Theme, ThemeError, Writer};
+use std::path::PathBuf;
+use std::process::Command;
+
+pub struct Waybar;
+
+/// First key that the theme actually defines, as rgb. Lets a writer use a
+/// colour that is not in the guaranteed key set without ever failing on a
+/// theme that omits it.
+fn opt_rgb(theme: &Theme, keys: &[&str], fallback: (u8, u8, u8)) -> (u8, u8, u8) {
+    for k in keys {
+        if let Some(v) = theme.vars.get(*k) {
+            if let Ok(c) = crate::hex_to_rgb(v) {
+                return c;
+            }
+        }
+    }
+    fallback
+}
+
+/// Blend `a` over `b`; `t` is the weight of `a`.
+fn mix(a: (u8, u8, u8), b: (u8, u8, u8), t: f32) -> (u8, u8, u8) {
+    let f = |x: u8, y: u8| (x as f32 * t + y as f32 * (1.0 - t)).round().clamp(0.0, 255.0) as u8;
+    (f(a.0, b.0), f(a.1, b.1), f(a.2, b.2))
+}
+
+impl Writer for Waybar {
+    fn name(&self) -> &'static str {
+        "waybar"
+    }
+
+    // Vars only. The user's own rules live in ~/.config/waybar/style.css and
+    // tokens/*.css, which this writer never touches.
+    fn output_path(&self) -> PathBuf {
+        crate::home().join(".config/waybar/tokens/theme-vars.css")
+    }
+
+    fn enabled(&self) -> bool {
+        crate::app_enabled("waybar", ".config/waybar")
+    }
+
+    fn generate(&self, theme: &Theme) -> Result<String, ThemeError> {
+        // Only keys every valid theme is required to define, so this writer
+        // cannot fail on a minimal or dynamically generated theme.
+        let base00 = theme.require_rgb("BASE00")?;
+        let base02 = theme.require_rgb("BASE02")?;
+        let base03 = theme.require_rgb("BASE03")?;
+        let base05 = theme.require_rgb("BASE05")?;
+        let base07 = theme.require_rgb("BASE07")?;
+        let darker_black = theme.require_rgb("DARKER_BLACK")?;
+        let black2 = theme.require_rgb("BLACK2")?;
+        let one_bg = theme.require_rgb("ONE_BG")?;
+        let one_bg2 = theme.require_rgb("ONE_BG2")?;
+        let one_bg3 = theme.require_rgb("ONE_BG3")?;
+        let grey = theme.require_rgb("GREY")?;
+        let white = theme.require_rgb("WHITE")?;
+        let red = theme.require_rgb("RED")?;
+        let green = theme.require_rgb("GREEN")?;
+        let yellow = theme.require_rgb("YELLOW")?;
+        let blue = theme.require_rgb("BLUE")?;
+        let cyan = theme.require_rgb("CYAN")?;
+        let teal = theme.require_rgb("TEAL")?;
+        let pink = theme.require_rgb("PINK")?;
+        let purple = theme.require_rgb("PURPLE")?;
+        let baby_pink = theme.require_rgb("BABY_PINK")?;
+
+        // Container tints and "fixed variant" shades are derived, because no
+        // theme key carries them: a container is the accent sunk into the
+        // background, a fixed variant is the accent pulled toward it.
+        // GTK wants a colour value, not three bare numbers: @define-color x 1, 2, 3;
+        // is a parse error that makes waybar exit, so every value is wrapped here.
+        let d = |c: (u8, u8, u8), t: f32| format!("rgb({})", rgb_str(mix(c, base00, t)));
+        let g = |c: (u8, u8, u8)| format!("rgb({})", rgb_str(c));
+
+        // Orange is not in the guaranteed key set, so fall back to the warm
+        // base16 slot and then to yellow.
+        let orange = opt_rgb(theme, &["ORANGE", "SUN", "BASE09"], yellow);
+
+        let corner_radius = theme.require("CORNER_RADIUS").unwrap_or("20");
+
+        Ok(format!(
+            "/* Generated by theme-manager. Do not edit manually.\n\
+             \tTo use: make ~/.config/waybar/tokens/colors.css contain only\n\
+             \t  @import \"theme-vars.css\";\n\
+             \tand keep your own rules in style.css and the other token files.\n\
+             \tThe token names below are the Material-style set waybar configs\n\
+             \tgenerally use, so existing stylesheets keep resolving unchanged.\n\
+             \n\
+             \tNote: GTK CSS has no variables for lengths, so border-radius\n\
+             \tcannot be templated. This theme's CORNER_RADIUS is {corner_radius}px.\n\
+             \t*/\n\
+             \n\
+             /* ---- surfaces ---- */\n\
+             @define-color background {base00};\n\
+             @define-color surface {base00};\n\
+             @define-color surface_dim {darker_black};\n\
+             @define-color surface_bright {one_bg3};\n\
+             \n\
+             @define-color surface_container_lowest {darker_black};\n\
+             @define-color surface_container_low {black2};\n\
+             @define-color surface_container {one_bg};\n\
+             @define-color surface_container_high {one_bg2};\n\
+             @define-color surface_container_highest {one_bg3};\n\
+             \n\
+             /* ---- foregrounds ---- */\n\
+             @define-color on_background {white};\n\
+             @define-color on_surface {white};\n\
+             @define-color on_surface_variant {base05};\n\
+             \n\
+             /* ---- primary ---- */\n\
+             @define-color primary {green};\n\
+             @define-color primary_fixed {green};\n\
+             @define-color primary_fixed_dim {cyan};\n\
+             @define-color primary_container {primary_container};\n\
+             @define-color on_primary {base00};\n\
+             @define-color on_primary_container {green};\n\
+             @define-color on_primary_fixed {base00};\n\
+             @define-color on_primary_fixed_variant {on_primary_fixed_variant};\n\
+             @define-color inverse_primary {primary_container};\n\
+             \n\
+             /* ---- secondary ---- */\n\
+             @define-color secondary {cyan};\n\
+             @define-color secondary_fixed {cyan};\n\
+             @define-color secondary_fixed_dim {cyan};\n\
+             @define-color secondary_container {secondary_container};\n\
+             @define-color on_secondary {base00};\n\
+             @define-color on_secondary_container {cyan};\n\
+             @define-color on_secondary_fixed {base00};\n\
+             @define-color on_secondary_fixed_variant {on_secondary_fixed_variant};\n\
+             \n\
+             /* ---- tertiary ---- */\n\
+             @define-color tertiary {white};\n\
+             @define-color tertiary_fixed {yellow};\n\
+             @define-color tertiary_fixed_dim {purple};\n\
+             @define-color tertiary_container {one_bg3};\n\
+             @define-color on_tertiary {base00};\n\
+             @define-color on_tertiary_container {white};\n\
+             @define-color on_tertiary_fixed {base00};\n\
+             @define-color on_tertiary_fixed_variant {grey};\n\
+             \n\
+             /* ---- error ---- */\n\
+             @define-color error {red};\n\
+             @define-color error_container {red};\n\
+             @define-color on_error {base00};\n\
+             @define-color on_error_container {base07};\n\
+             @define-color error_hover_bg {error_hover_bg};\n\
+             @define-color error_hover_fg {error_hover_fg};\n\
+             \n\
+             /* ---- lines, misc ---- */\n\
+             @define-color outline {grey};\n\
+             @define-color outline_variant {base03};\n\
+             @define-color surface_variant {one_bg2};\n\
+             @define-color inverse_surface {white};\n\
+             @define-color inverse_on_surface {base00};\n\
+             @define-color scrim {darker_black};\n\
+             @define-color shadow {darker_black};\n\
+             @define-color source_color {green};\n\
+             @define-color surface_tint {green};\n\
+             \n\
+             /* ---- named accents, for per-module colours ---- */\n\
+             @define-color accent_ok {green};\n\
+             @define-color accent_warn {yellow};\n\
+             @define-color accent_danger {red};\n\
+             @define-color accent_info {cyan};\n\
+             @define-color accent_blue {blue};\n\
+             @define-color accent_teal {teal};\n\
+             @define-color accent_purple {purple};\n\
+             @define-color accent_pink {pink};\n\
+             @define-color accent_baby_pink {baby_pink};\n\
+             @define-color accent_orange {orange};\n\
+             @define-color accent_muted {base02};\n",
+            base00 = g(base00),
+            base02 = g(base02),
+            orange = g(orange),
+            base03 = g(base03),
+            base05 = g(base05),
+            base07 = g(base07),
+            darker_black = g(darker_black),
+            black2 = g(black2),
+            one_bg = g(one_bg),
+            one_bg2 = g(one_bg2),
+            one_bg3 = g(one_bg3),
+            grey = g(grey),
+            white = g(white),
+            red = g(red),
+            green = g(green),
+            yellow = g(yellow),
+            blue = g(blue),
+            cyan = g(cyan),
+            teal = g(teal),
+            pink = g(pink),
+            purple = g(purple),
+            baby_pink = g(baby_pink),
+            primary_container = d(green, 0.22),
+            secondary_container = d(cyan, 0.22),
+            on_primary_fixed_variant = d(green, 0.80),
+            on_secondary_fixed_variant = d(cyan, 0.80),
+            error_hover_bg = d(red, 0.12),
+            error_hover_fg = format!("rgb({})", rgb_str(mix(red, white, 0.65))),
+            corner_radius = corner_radius,
+        ))
+    }
+
+    fn reload(&self) {
+        let running = Command::new("pgrep")
+            .args(["--exact", "waybar"])
+            .output()
+            .map(|o| o.status.success())
+            .unwrap_or(false);
+
+        if !running {
+            return;
+        }
+
+        // SIGUSR2 makes waybar re-read its config and stylesheet.
+        let status = Command::new("pkill").args(["-SIGUSR2", "-x", "waybar"]).status();
+        match status {
+            Ok(s) if s.success() => eprintln!("theme-manager: [waybar] reloaded"),
+            Ok(s) => eprintln!("theme-manager: [waybar] pkill exited with {s}"),
+            Err(e) => eprintln!("theme-manager: [waybar] pkill failed: {e}"),
+        }
+    }
+}
