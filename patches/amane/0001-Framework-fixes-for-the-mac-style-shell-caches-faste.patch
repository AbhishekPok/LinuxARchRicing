+// the font's own metrics (ascent, descent, units per em...), parsed once per font
+pub fn metrics(font: FontRef<'static>) -> swash::Metrics {
+    let key = font.key.value();
+
+    if let Some(found) = METRICS.with_borrow(|all| all.get(&key).copied()) {
+        return found;
+    }
+
+    let found = font.metrics(coords(font));
+
+    METRICS.with_borrow_mut(|all| all.insert(key, found));
+
