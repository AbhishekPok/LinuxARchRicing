diff --git a/src/input/target.rs b/src/input/target.rs
index 7b13fed..4e002c0 100644
--- a/src/input/target.rs
+++ b/src/input/target.rs
@@ -69,6 +69,30 @@ impl Target {
  */
 pub fn clip(targets: &mut [Target], area: Area) {
     for target in targets {
-        target.area = target.area.intersect(area);
+        /*
+         * the clip is in the clipping widget's space, a target moved inside it
+         * (a page scrolled with translate, say) has its own, so the clip is
+         * brought into the target's space first; otherwise rows scrolled into
+         * view stay dead and rows scrolled out keep taking clicks
+         */
+        let local = local_area(&target.inverse, area);
+
+        target.area = target.area.intersect(local);
     }
 }
+
+// the smallest area in the target's own space that covers `area`
+fn local_area(inverse: &Transform, area: Area) -> Area {
+    let right = area.x + area.width;
+    let bottom = area.y + area.height;
+
+    let corners = [(area.x, area.y), (right, area.y), (area.x, bottom), (right, bottom)]
+        .map(|(x, y)| inverse.map(x, y));
+
+    let left = corners.iter().map(|c| c.0).fold(f32::INFINITY, f32::min);
+    let top = corners.iter().map(|c| c.1).fold(f32::INFINITY, f32::min);
+    let right = corners.iter().map(|c| c.0).fold(f32::NEG_INFINITY, f32::max);
+    let bottom = corners.iter().map(|c| c.1).fold(f32::NEG_INFINITY, f32::max);
+
+    Area::new(left, top, right - left, bottom - top)
+}
