+
+    let Role::Lock(lock_surface) = role else {
+        drop(fractional);
+
+        return;
+    };
+
+    // the viewport and scale objects belong to the surface, so they stay with it
+    std::mem::forget(fractional);
+    std::mem::forget(lock_surface);
