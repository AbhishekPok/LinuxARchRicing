 use crate::services::worker;
 use crate::{Service, Value};
@@ -32,12 +33,24 @@ pub struct Network {
 }
 
 /*
- * polled, because the access point's strength
- * changes all the time without a new connection
+ * polled, because the access point's strength changes all the time
+ * without a new connection. The full access point list costs
+ * networkmanager dozens of dbus calls (every ap, every saved profile),
+ * so it is only fetched while a window is actually showing it;
+ * otherwise the link, ssid and strength are checked every few seconds
  */
+static WANTS_LIST: AtomicBool = AtomicBool::new(false);
+
+// with a list on screen, and without one
+const LISTING: Duration = Duration::from_secs(1);
+const IDLE: Duration = Duration::from_secs(5);
+
+// a list read this recently counts as still on screen
+const LIST_SHOWN_FOR: Duration = Duration::from_secs(30);
+
 impl Service for Network {
     fn new() -> Self {
-        fetch()
+        fetch(true)
     }
 
     /*
@@ -46,10 +59,33 @@ impl Service for Network {
      * the windows aren't redrawn every second for no reason
      */
     fn listen() {
+        let mut seen = crate::services::activity_generation();
+        let mut listed_at: Option<Instant> = None;
+        let mut fetched = Instant::now();
+
         loop {
-            thread::sleep(Self::interval());
+            let listing = listed_at.is_some_and(|t| t.elapsed() < LIST_SHOWN_FOR);
+
+            // opening the wifi page is input, which wakes this at once
+            crate::services::wait_for_activity(if listing { LISTING } else { IDLE }, &mut seen);
+
+            // input wakes this often (every hover), but networkmanager is asked at most once a second
+            if let Some(rest) = LISTING.checked_sub(fetched.elapsed()) {
+                std::thread::sleep(rest);
+            }
 
-            let fresh = fetch();
+            if WANTS_LIST.swap(false, Ordering::Relaxed) {
+                listed_at = Some(Instant::now());
+            }
+
+            let listing = listed_at.is_some_and(|t| t.elapsed() < LIST_SHOWN_FOR);
+
+            let mut fresh = fetch(listing);
+            fetched = Instant::now();
+
+            if !listing {
+                fresh.access_points = Self::read().access_points.clone();
+            }
 
             if *Self::read() == fresh {
                 continue;
@@ -86,6 +122,8 @@ impl Network {
     }
 
     pub fn access_points(&self) -> &[AccessPoint] {
+        WANTS_LIST.store(true, Ordering::Relaxed);
+
         &self.access_points
     }
 }
@@ -160,7 +198,7 @@ fn ssid(bytes: &Value) -> String {
 }
 
 // asks networkmanager for everything shown, from scratch
-fn fetch() -> Network {
+fn fetch(list: bool) -> Network {
     // networks to join are listed even while offline
     let mut network = Network {
         wifi_enabled: manager::wifi_enabled(),
@@ -168,7 +206,9 @@ fn fetch() -> Network {
     };
 
     if let Some(device) = wifi::device() {
-        network.access_points = wifi::access_points(&device);
+        if list {
+            network.access_points = wifi::access_points(&device);
+        }
         network.connecting = wifi::connecting(&device);
     }
 
