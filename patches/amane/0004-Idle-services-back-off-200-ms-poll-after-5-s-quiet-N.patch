diff --git a/src/services.rs b/src/services.rs
index e7dc56e..668c41c 100644
--- a/src/services.rs
+++ b/src/services.rs
@@ -18,9 +18,10 @@ mod workspaces;
 mod write;
 
 use std::any::TypeId;
+use std::cell::Cell;
+use std::sync::{Condvar, Mutex, PoisonError};
+use std::time::{Duration, Instant};
 use parking_lot::RwLockReadGuard;
-use std::thread;
-use std::time::Duration;
 
 use crate::changes;
 
@@ -59,14 +60,36 @@ pub trait Service: Send + Sync + Sized + 'static {
      * own loop, and services that only change through input with
      * an empty one
      */
+    /*
+     * polls at interval() for a while after anything happens, then backs
+     * off to IDLE_POLL so a settled shell isn't waking the cpu 30-60 times
+     * a second for nothing; input, an event-driven service or this
+     * service's own change brings the fast rate straight back
+     */
     fn listen() {
+        let mut seen = activity_generation();
+        let mut busy_until = Instant::now() + BUSY_FOR;
+
         loop {
-            thread::sleep(Self::interval());
+            let fast = Self::interval();
+
+            if Instant::now() < busy_until || fast >= IDLE_POLL {
+                std::thread::sleep(fast);
+            } else if wait_for_activity(IDLE_POLL, &mut seen) {
+                busy_until = Instant::now() + BUSY_FOR;
+            }
+
+            if activity_generation() != seen {
+                seen = activity_generation();
+                busy_until = Instant::now() + BUSY_FOR;
+            }
 
             let mut service = Self::write();
 
             // a poll that found nothing new redraws nothing
-            if !service.update() {
+            if service.update() {
+                busy_until = Instant::now() + BUSY_FOR;
+            } else {
                 service.quiet();
             }
         }
@@ -98,6 +121,66 @@ pub trait Service: Send + Sync + Sized + 'static {
     }
 }
 
+// how long polling stays at full rate after the last sign of life
+const BUSY_FOR: Duration = Duration::from_secs(5);
+
+// the slowest a fast service polls while nothing is happening
+const IDLE_POLL: Duration = Duration::from_millis(200);
+
+/*
+ * bumped by every change that didn't come from a timed poll (input
+ * handlers, ipc, event-driven services), so idle pollers wake at once
+ */
+static ACTIVITY: (Mutex<u64>, Condvar) = (Mutex::new(0), Condvar::new());
+
+thread_local! {
+    // set on every service listener thread
+    pub(crate) static POLLING: Cell<bool> = const { Cell::new(false) };
+}
+
+/*
+ * a write counts as activity unless it came from a background listener:
+ * timed reads like cpu, ops or the clock change every few seconds and
+ * would keep every fast poller awake for good
+ */
+pub(crate) fn note_activity() {
+    if POLLING.with(Cell::get) {
+        return;
+    }
+
+    wake_pollers();
+}
+
+// for listeners whose events are user-visible activity (workspaces, audio)
+pub(crate) fn wake_pollers() {
+    let (generation, wake) = &ACTIVITY;
+
+    *generation.lock().unwrap_or_else(PoisonError::into_inner) += 1;
+
+    wake.notify_all();
+}
+
+pub(crate) fn activity_generation() -> u64 {
+    *ACTIVITY.0.lock().unwrap_or_else(PoisonError::into_inner)
+}
+
+// true when woken by activity, false when the timeout ran out
+pub(crate) fn wait_for_activity(timeout: Duration, seen: &mut u64) -> bool {
+    let (generation, wake) = &ACTIVITY;
+
+    let guard = generation.lock().unwrap_or_else(PoisonError::into_inner);
+
+    let (guard, _) = wake
+        .wait_timeout_while(guard, timeout, |g| *g == *seen)
+        .unwrap_or_else(PoisonError::into_inner);
+
+    let woken = *guard != *seen;
+
+    *seen = *guard;
+
+    woken
+}
+
